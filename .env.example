# 数据库（Docker 内 pgvector，端口 5433）
LIRA_DATABASE_URL=postgresql://lira:lira_dev_2026@127.0.0.1:5433/lira

# 登录签名密钥（生产务必替换）
LIRA_JWT_SECRET=change-me-in-production

# 正式分析模型：OpenAI 兼容协议。留空则自动降级为确定性分析引擎。
LIRA_LLM_PROVIDER=qwen
LIRA_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LIRA_LLM_MODEL=qwen-plus
LIRA_LLM_API_KEY=

# 仅测试用途：本机 Ollama 4B，能力有限，不用于生产结论
LIRA_TEST_LLM_BASE_URL=http://127.0.0.1:11434/v1
LIRA_TEST_LLM_MODEL=qwen3:4b
